  <property name="styleSheet">
   <string notr="true">QWidget#NavigationPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0d0d1a, stop:1 #1a1a2e);
}

QLabel#titleLabel {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
}

QLabel#patientInfoLabel {
    color: #a0a0a0;
    font-size: 14px;
}

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.02);
    top: -1px;
}

QTabBar::tab {
    background-color: rgba(255, 255, 255, 0.05);
    color: #a0a0a0;
    padding: 14px 35px;
    margin-right: 5px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 14px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: rgba(34, 211, 238, 0.18);
    color: #ffffff;
    border-bottom: 3px solid #22d3ee;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 255, 255, 0.1);
}

QFrame#viewFrame {
    background-color: #000000;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
}

QLabel#viewLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 5px 10px;
    border-radius: 4px;
}

QFrame#controlPanel {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QGroupBox {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #22d3ee;
}

QPushButton {
    background-color: #0f3460;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #22d3ee;
}

QPushButton:disabled {
    background-color: #333333;
    color: #666666;
}

QPushButton#backButton {
    background-color: transparent;
    color: #a0a0a0;
    border: 1px solid #a0a0a0;
}

QPushButton#backButton:hover {
    color: #ffffff;
    border-color: #ffffff;
}

QPushButton#connectButton {
    background-color: #27ae60;
}

QPushButton#connectButton:hover {
    background-color: #2ecc71;
}

QPushButton#disconnectButton {
    background-color: #c0392b;
}

QPushButton#disconnectButton:hover {
    background-color: #e74c3c;
}

QLabel {
    color: #a0a0a0;
    font-size: 14px;
}

QLabel#statusValue {
    color: #ffffff;
    font-weight: bold;
}

QLabel#statusConnected {
    color: #27ae60;
    font-weight: bold;
}

QLabel#statusDisconnected {
    color: #c0392b;
    font-weight: bold;
}

QProgressBar {
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #22d3ee;
    border-radius: 4px;
}

QSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.1);
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #22d3ee;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #22d3ee;
    border-radius: 3px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QWidget#instrumentScrollContent {
    background: transparent;
}</string>

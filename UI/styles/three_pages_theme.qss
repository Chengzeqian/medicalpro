QWidget#SystemSettingsPage QLabel#frameworkStatusSummaryLabel,
QWidget#SystemSettingsPage QLabel#serviceStatusSummaryLabel,
QWidget#SystemSettingsPage QLabel#pathStatusSummaryLabel {
    color: ${TEXT_PRIMARY};
    font-size: 22px;
    font-weight: 700;
}

QWidget#SystemSettingsPage QLabel#generalSettingsTitleLabel,
QWidget#SystemSettingsPage QLabel#deviceSettingsTitleLabel,
QWidget#SystemSettingsPage QLabel#pathSettingsTitleLabel {
    color: ${TEXT_PRIMARY};
    font-size: 19px;
    font-weight: 700;
}

QWidget#SystemSettingsPage QLabel#generalSettingsDescLabel,
QWidget#SystemSettingsPage QLabel#deviceSettingsDescLabel,
QWidget#SystemSettingsPage QLabel#pathSettingsDescLabel {
    color: ${TEXT_SECONDARY};
    font-size: 13px;
}

QWidget#SystemSettingsPage QLabel#frameworkStatusDetailLabel,
QWidget#SystemSettingsPage QLabel#serviceStatusDetailLabel,
QWidget#SystemSettingsPage QLabel#pathStatusDetailLabel {
    color: ${TEXT_SECONDARY};
    font-size: 13px;
    line-height: 1.4em;
}

QWidget#SystemSettingsPage QLabel#systemRecommendationLabel {
    color: ${TEXT_PRIMARY};
    font-size: 16px;
    font-weight: 600;
}

QWidget#SystemSettingsPage QLabel#languageLabel,
QWidget#SystemSettingsPage QLabel#themeLabel,
QWidget#SystemSettingsPage QLabel#autoSaveLabel,
QWidget#SystemSettingsPage QLabel#trackerPortLabel,
QWidget#SystemSettingsPage QLabel#baudRateLabel,
QWidget#SystemSettingsPage QLabel#dataPathLabel,
QWidget#SystemSettingsPage QLabel#dicomPathLabel {
    color: ${TEXT_MUTED};
    font-size: 14px;
    font-weight: 600;
}

QWidget#SystemSettingsPage QLineEdit,
QWidget#SystemSettingsPage QComboBox {
    min-height: 46px;
    padding: 0 14px;
    border-radius: 12px;
    background-color: rgba(7, 16, 27, 0.82);
    border: 1px solid ${BORDER_SOFT};
    color: ${TEXT_PRIMARY};
}

QWidget#SystemSettingsPage QLineEdit:focus,
QWidget#SystemSettingsPage QComboBox:focus {
    border-color: ${ACCENT_SECONDARY};
}

QWidget#SystemSettingsPage QCheckBox {
    color: ${TEXT_PRIMARY};
    font-size: 14px;
}

QWidget#SystemSettingsPage QPushButton#browseDataPathButton,
QWidget#SystemSettingsPage QPushButton#browseDicomPathButton {
    min-height: 42px;
    min-width: 104px;
    padding: 0 14px;
    border-radius: 12px;
    background-color: rgba(8, 18, 30, 0.30);
    border: 1px solid rgba(124, 160, 191, 0.14);
    color: ${TEXT_SECONDARY};
}

QWidget#SystemSettingsPage QPushButton#browseDataPathButton:hover,
QWidget#SystemSettingsPage QPushButton#browseDicomPathButton:hover {
    background-color: rgba(11, 22, 35, 0.56);
    border-color: rgba(124, 160, 191, 0.24);
    color: ${TEXT_PRIMARY};
}

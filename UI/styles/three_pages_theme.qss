QLabel#ankleSurgeryIcon,
QLabel#systemSettingsIcon {
    color: ${ACCENT_SECONDARY};
    font-size: 28px;
    font-weight: 700;
}

QLabel#ankleSurgeryTitle,
QLabel#systemSettingsTitle,
QLabel#patientNameLabel {
    color: ${TEXT_PRIMARY};
    font-size: 20px;
    font-weight: 700;
}

QLabel#ankleSurgeryDesc,
QLabel#systemSettingsDesc,
QLabel#userInfoLabel {
    color: ${TEXT_SECONDARY};

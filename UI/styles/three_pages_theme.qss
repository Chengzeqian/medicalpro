QWidget#WelcomePage,
QWidget#ModuleSelectionPage,
QWidget#ManagementPage,
QWidget#DashboardPage,
QWidget#SystemSettingsPage,
QWidget#NavigationPage {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 ${PAGE_BG_START},
        stop: 0.58 ${PAGE_BG_END},
        stop: 1 ${PAGE_BG_ACCENT}
    );
    color: ${TEXT_PRIMARY};
}

QWidget#WelcomePage QLabel,
QWidget#ModuleSelectionPage QLabel,
QWidget#ManagementPage QLabel,
QWidget#DashboardPage QLabel,
QWidget#SystemSettingsPage QLabel,
QWidget#NavigationPage QLabel {
    color: ${TEXT_SECONDARY};
    font-size: 14px;
}

QWidget#WelcomePage QLabel#titleLabel,
QWidget#ModuleSelectionPage QLabel#titleLabel,
QWidget#ManagementPage QLabel#titleLabel,
QWidget#DashboardPage QLabel#titleLabel,
QWidget#SystemSettingsPage QLabel#titleLabel,
QWidget#NavigationPage QLabel#titleLabel {
    color: ${TEXT_PRIMARY};
    font-size: 30px;
    font-weight: 700;
}

QWidget#WelcomePage QLabel#subtitleLabel,
QWidget#ModuleSelectionPage QLabel#subtitleLabel,
QWidget#ManagementPage QLabel#subtitleLabel,
QWidget#SystemSettingsPage QLabel#subtitleLabel,
QWidget#NavigationPage QLabel#subtitleLabel {
    color: ${TEXT_SECONDARY};
    font-size: 16px;
}

QWidget#WelcomePage QLabel#logoLabel {
    color: ${ACCENT_PRIMARY};
    font-size: 32px;
    font-weight: 700;
    background: transparent;
}

QWidget#WelcomePage QLabel#versionLabel {
    color: ${TEXT_MUTED};
    font-size: 13px;
}

QWidget#WelcomePage QPushButton,
QWidget#ModuleSelectionPage QPushButton,
QWidget#ManagementPage QPushButton,
QWidget#DashboardPage QPushButton,
QWidget#SystemSettingsPage QPushButton,
QWidget#NavigationPage QPushButton {
    min-height: 42px;
    padding: 10px 20px;
    border-radius: 12px;
    border: 1px solid ${BORDER_SOFT};
    background-color: ${SURFACE_CARD};
    color: ${TEXT_PRIMARY};
    font-size: 14px;
    font-weight: 600;
}

QWidget#WelcomePage QPushButton:hover,
QWidget#ModuleSelectionPage QPushButton:hover,
QWidget#ManagementPage QPushButton:hover,
QWidget#DashboardPage QPushButton:hover,
QWidget#SystemSettingsPage QPushButton:hover,
QWidget#NavigationPage QPushButton:hover {
    background-color: ${SURFACE_CARD_HOVER};
    border-color: ${ACCENT_SECONDARY};
}

QWidget#WelcomePage QPushButton:pressed,
QWidget#ModuleSelectionPage QPushButton:pressed,
QWidget#ManagementPage QPushButton:pressed,
QWidget#DashboardPage QPushButton:pressed,
QWidget#SystemSettingsPage QPushButton:pressed,
QWidget#NavigationPage QPushButton:pressed {
    padding-top: 11px;
    padding-bottom: 9px;
}

QWidget#WelcomePage QPushButton#enterButton,
QWidget#DashboardPage QPushButton#enterNavigationButton,
QWidget#ManagementPage QPushButton#enterDashboardButton,
QWidget#ManagementPage QPushButton#enterDashboardButtonSecondary,
QWidget#ModuleSelectionPage QPushButton#ankleSurgeryButton,
QWidget#SystemSettingsPage QPushButton#saveButton {
    background-color: ${ACCENT_PRIMARY};
    border-color: ${ACCENT_PRIMARY};
    color: ${TEXT_PRIMARY};
}

QWidget#WelcomePage QPushButton#enterButton:hover,
QWidget#DashboardPage QPushButton#enterNavigationButton:hover,
QWidget#ManagementPage QPushButton#enterDashboardButton:hover,
QWidget#ManagementPage QPushButton#enterDashboardButtonSecondary:hover,
QWidget#ModuleSelectionPage QPushButton#ankleSurgeryButton:hover,
QWidget#SystemSettingsPage QPushButton#saveButton:hover {
    background-color: ${ACCENT_PRIMARY_HOVER};
    border-color: ${ACCENT_PRIMARY_HOVER};
}

QWidget#WelcomePage QPushButton#exitButton,
QWidget#ModuleSelectionPage QPushButton#logoutButton,
QWidget#ManagementPage QPushButton#backButton,
QWidget#DashboardPage QPushButton#logoutButton,
QWidget#DashboardPage QPushButton#backButton,
QWidget#SystemSettingsPage QPushButton#backButton,
QWidget#NavigationPage QPushButton#backButton {
    background-color: transparent;

}

QLabel#patientListTitle,
QLabel#basicInfoLabel,
QLabel#doctorInfoLabel,
QLabel#dicomInfoLabel {
    color: ${ACCENT_PRIMARY};
    font-size: 16px;
    font-weight: 700;
}

QLineEdit#patientSearchEdit {
    min-height: 40px;
    padding: 0 14px;
    border-radius: 12px;
    background-color: ${SURFACE_PANEL};
    border: 1px solid ${BORDER_SOFT};
    color: ${TEXT_PRIMARY};
    selection-background-color: ${ACCENT_SECONDARY};
}

QLineEdit#patientSearchEdit:focus {
    border-color: ${ACCENT_SECONDARY};
}

QListWidget#patientListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    color: ${TEXT_PRIMARY};
    font-size: 14px;
}

QListWidget#patientListWidget::item {
    min-height: 24px;
    margin: 4px 0;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid transparent;
}

QListWidget#patientListWidget::item:selected {
    background-color: rgba(91, 182, 255, 0.14);
    border-color: ${ACCENT_SECONDARY};
}

QListWidget#patientListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.05);
}

QLabel#idLabel,
QLabel#genderLabel,
QLabel#ageLabel,
QLabel#phoneLabel,
QLabel#diagnosisLabel,
QLabel#doctorNameLabel,
QLabel#departmentLabel,
QLabel#noDicomLabel,
QLabel#dicomDateLabel {
    color: ${TEXT_PRIMARY};
    font-size: 14px;
}

QLabel#idLabelTitle,
QLabel#genderLabelTitle,
QLabel#ageLabelTitle,
QLabel#phoneLabelTitle,
QLabel#diagnosisLabelTitle,
QLabel#doctorNameLabelTitle,
QLabel#departmentLabelTitle {
    color: ${TEXT_MUTED};
    font-size: 14px;
}

QLabel#noDicomLabel {
    padding: 18px;
    border: 1px dashed ${BORDER_STRONG};
    border-radius: 14px;
    background-color: rgba(8, 18, 30, 0.78);
}

QLabel#dicomThumbLabel {
    min-width: 112px;
    min-height: 78px;
    border-radius: 10px;
    background-color: ${SURFACE_PANEL};
    border: 1px solid ${BORDER_SOFT};
    color: ${TEXT_MUTED};
    font-weight: 600;
}

QScrollArea#detailScrollArea,
QScrollArea#dicomScrollArea {
    border: none;
    background: transparent;
}

QSplitter#mainSplitter::handle {
    background-color: transparent;
    width: 6px;
}

QWidget#WelcomePage QFrame#welcomeHeroFrame,
QWidget#WelcomePage QFrame#statusCardsFrame {
    background: transparent;
    border: none;
}

QWidget#WelcomePage QFrame#brandPanelFrame,
QWidget#WelcomePage QFrame#runtimeSummaryFrame {
    border-radius: 24px;
}

QWidget#WelcomePage QFrame#brandPanelFrame {
    background: qradialgradient(
        cx: 0.08, cy: 0.12, radius: 1.2,
        fx: 0.08, fy: 0.12,
        stop: 0 rgba(44, 126, 173, 0.34),
        stop: 0.18 rgba(28, 67, 93, 0.26),
        stop: 0.54 rgba(9, 22, 34, 0.96),
        stop: 1 rgba(6, 14, 24, 1)
    );
    border: 1px solid rgba(78, 205, 224, 0.28);
}

QWidget#WelcomePage QFrame#runtimeSummaryFrame {
    background-color: rgba(7, 16, 27, 0.72);
    border: 1px solid rgba(124, 160, 191, 0.07);
}

QWidget#WelcomePage QLabel#logoLabel {
    min-width: 396px;

QFrame#ankleSurgeryCard,
QFrame#systemSettingsCard,
QFrame#patientListFrame,
QFrame#patientDetailFrame,
QFrame#dicomStudyCard {
    background-color: ${SURFACE_SOFT};
    border: 1px solid ${BORDER_SOFT};
    border-radius: 18px;
}

QFrame#ankleSurgeryCard:hover,
QFrame#systemSettingsCard:hover,
QFrame#dicomStudyCard:hover {
    background-color: ${SURFACE_CARD_HOVER};
    border-color: ${ACCENT_SECONDARY};
